{
  "name": "overnightworks-design",
  "version": "0.43.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "src/design/static/design.css",
    "src/design/static/fonts",
    "svelte-dist",
    "!svelte-dist/**/*.test.*"
  ],
  "exports": {
    ".": {
      "types": "./svelte-dist/index.d.ts",
      "svelte": "./svelte-dist/index.js"
    },
    "./design.css": "./src/design/static/design.css",
    "./words": {
      "types": "./svelte-dist/kitWords.d.ts",
      "default": "./svelte-dist/kitWords.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "svelte": "^5.20.0"
  },
  "scripts": {
    "package": "svelte-package --input src/lib --output svelte-dist",
    "prepack": "pnpm run package",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project client && vitest run --project server",
    "test:consumer": "rm -rf coverage/drive && playwright test --config tests/e2e/playwright.config.ts",
    "build:parts-page": "node tests/e2e/build-parts-page.ts",
    "open:parts-page": "node tests/e2e/open-parts-page.ts",
    "coverage:merge": "nyc report --temp-dir coverage/drive --report-dir coverage/remapped --reporter json --extension .svelte --extension .ts && nyc report --temp-dir coverage/remapped --report-dir coverage --reporter lcov --reporter text --reporter json-summary --extension .svelte --extension .ts && nyc check-coverage --temp-dir coverage/remapped --branches 100 --extension .svelte --extension .ts && node scripts/compare_coverage_merge.mjs"
  },
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24 || ^26"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/coverage-istanbul": "5.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "31.0.1",
    "nyc": "18.0.0",
    "pyright": "1.1.414",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "^5.1.1"
  }
}
